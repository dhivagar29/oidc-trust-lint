          "level": "warning",
          "message": {
            "text": "StringLike used for \"token.actions.githubusercontent.com:aud\" but value(s) contain no wildcards: \"sts.amazonaws.com\". Fix: Use StringEquals for exact matches. Reserve StringLike for patterns that include * or ?."
          },
          "locations": [
